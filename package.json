{
  "name": "dsh-plugin-share",
  "version": "0.2.1",
  "description": "Offline DSH plugin set sharing with a compact D1/NP1 code",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.mjs",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HGT158/dsh-plugin-share.git"
  },
  "homepage": "https://github.com/HGT158/dsh-plugin-share#readme",
  "bugs": {
    "url": "https://github.com/HGT158/dsh-plugin-share/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-share"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "icon.svg",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "PLAN.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "encode:example": "node src/cli.mjs encode examples/plugins.json"
  }
}
